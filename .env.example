# Google Drive OAuth credentials. Keep these only on the backend/server.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback
# Set a long random value before deploying.
FLASK_SECRET_KEY=replace-with-a-long-random-value
# Groq chat model used to turn the transcript into meeting minutes.
GROQ_CHAT_MODEL=openai/gpt-oss-120b
# Comma-separated browser origins permitted to call the separate API.
FRONTEND_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,https://sumo-mom-agent-gamma.vercel.app
# Production only: paste the complete contents of google_drive_token.json as
# one JSON value. Do not commit this value or expose it in the frontend.
GOOGLE_TOKEN_JSON=
